# Fledge customer web environment
#
# Setup:
#   cp .env.example .env.local
# Never commit .env.local. Next.js exposes every NEXT_PUBLIC_* value to the
# browser, so those values must never contain passwords, private API keys, or
# server credentials.

# ── Backend and BFF routing (required) ───────────────────────────────────────
# Server-only NestJS origin, without /api/v1 and without a trailing slash.
# Local:      http://localhost:4001
# Production: https://api-fledge.nearestz.com
BACKEND_API_BASE_URL=http://localhost:4001

# Optional shared cookie domain. Leave unset on localhost. Production defaults
# to .nearestz.com so sessions can be shared safely across Fledge subdomains.
# COOKIE_DOMAIN=.nearestz.com

# Browser API base. /api/proxy keeps access/refresh tokens in HttpOnly cookies
# and is the recommended value. Use the absolute backend origin only for a
# deliberate direct-browser deployment with matching backend CORS settings.
NEXT_PUBLIC_API_BASE_URL=/api/proxy

# Fallback realtime origin, without /realtime. The client first asks the
# backend for its hybrid route, so this is only used when route discovery is
# unavailable. Production: https://api-fledge.nearestz.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# Client protocol selector. Use hybrid for the production Edge + VM router.
# Supported: socket.io | ws | uwebsockets | rust-native | cpp-native | hybrid
# Every value except socket.io uses the raw RFC6455 WebSocket client.
NEXT_PUBLIC_REALTIME_DRIVER=hybrid

# Legacy compatibility alias. Leave unset in new deployments; if used, it is
# a public browser value and must point only to the backend origin.
# NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:4001

# ── Public app metadata and navigation ──────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Fledge
# true/1/yes shows the Beta badge; false/0 hides it.
NEXT_PUBLIC_IS_BETA=true
# Production must be the deployed partner-portal origin.
NEXT_PUBLIC_PARTNER_URL=http://localhost:3002

# Deprecated beta aliases; use NEXT_PUBLIC_IS_BETA instead.
# NEXT_PUBLIC_SHOW_BETA_TAG=true
# NEXT_PUBLIC_BETA=true

# ── Runtime customer-home flags (server-only, no rebuild required) ─────────
# Enable the home-page roommate feed. Safe default is off.
HOME_ROOMMATE_FEED_ENABLED=false
# Number of roommate cards; the app clamps this to 1..12.
HOME_ROOMMATE_FEED_COUNT=6

# ── Google Identity Services (public browser OAuth client ID) ───────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web
# client. Add local/production origins in Google; never put a client secret here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=428654341426-r88d8l21g5v9rh567j6j21ss73ugm73d.apps.googleusercontent.com

# ── Firebase web push (optional, server-read public Firebase web config) ────
# Firebase Console -> Project settings -> General -> Web app, plus Cloud
# Messaging -> Web Push certificates for the VAPID public key. Push remains
# disabled while these placeholders are present.
FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
FIREBASE_VAPID_KEY=YOUR_FIREBASE_PUBLIC_VAPID_KEY

# ── Firebase phone verification (optional, browser-visible) ─────────────────
# These NEXT_PUBLIC_* values initialize Firebase Auth in the phone-verification
# page. Use the same Firebase web app as above; enable Phone Auth and register
# every deployed domain in Firebase Authentication -> Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_WEB_APP_ID
